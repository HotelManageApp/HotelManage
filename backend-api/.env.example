# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://hotel:hotel_dev_only@localhost:5432/hotel
APP_VERSION=dev
LOG_LEVEL=INFO
DB_HEALTH_TIMEOUT_SECONDS=2

# Staff auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
STAFF_ACCESS_TOKEN_MINUTES=15
STAFF_REFRESH_TOKEN_HOURS=12
# JSON list of origins allowed to call /staff/auth/refresh and /logout
ADMIN_WEB_ORIGINS=["http://localhost:3000"]

# Tests only (optional; this is the default):
# TEST_DATABASE_URL=postgresql+asyncpg://hotel:hotel_dev_only@localhost:5432/hotel_test

# Password for the three seed-dev accounts (APP_ENV=dev only)
DEV_STAFF_PASSWORD=change-me-dev-only

# Guest access (room codes). Use two different random strings (>= 32 chars each).
STAY_JWT_SECRET=change-me-another-random-string-of-32-plus-chars
ROOM_CODE_PEPPER=change-me-a-third-random-string-of-32-plus-chars
STAY_GRACE_HOURS=6
MAX_DEVICES_PER_STAY=6
